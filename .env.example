# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Auth (REQUIRED) ---
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Logging ---
LOG_LEVEL=INFO

# --- Database ---
# Defaults to local SQLite if unset. For Postgres (Neon, Supabase, Cloud SQL):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- LLM (REQUIRED for AI replies) ---
GROQ_API_KEY=
# Optional alternate providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
# Generation tuning (optional — sensible defaults shown).
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=500
# Groq request timeout in seconds; the call fails rather than hanging the worker.
LLM_TIMEOUT=30

# --- Mailbox credential encryption ---
# Fernet key encrypting each Company's stored mailbox App Password at rest.
# CRITICAL secret — if lost, every stored mailbox credential is unrecoverable.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_ENCRYPTION_KEY=

# --- Support mailbox ---
# Per-Company support mailboxes are connected at runtime via
# POST /api/v1/mailbox/connect; credentials are encrypted at rest with the key
# above. EMAIL_USER / EMAIL_PASS below are used ONLY by the legacy standalone
# Streamlit apps (chat_app.py, email_streamlit_ui.py) — not the backend.
EMAIL_USER=
EMAIL_PASS=

# --- Transactional email (Resend) — password-reset emails ---
# Sign up at resend.com for an API key. RESEND_FROM_EMAIL must be on a
# verified domain; the default onboarding@resend.dev works for testing but
# can only send to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Base URL the password-reset link points at (the frontend reset page).
APP_BASE_URL=http://localhost:8000
# How long a reset link stays valid.
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Escalation engine (optional — defaults shown) ---
# A fresh AI draft escalates its Ticket to a human below this confidence,
# or once the thread already has this many replies out.
ESCALATION_CONFIDENCE_THRESHOLD=40
ESCALATION_MAX_REPLIES=2
