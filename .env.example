# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Auth (REQUIRED) ---
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Logging ---
LOG_LEVEL=INFO

# --- Database ---
# Defaults to local SQLite if unset. For Postgres (Neon, Supabase, Cloud SQL):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- LLM (REQUIRED for AI replies) ---
GROQ_API_KEY=
# Optional alternate providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile

# --- Mailbox credential encryption ---
# Fernet key encrypting each Company's stored mailbox App Password at rest.
# CRITICAL secret — if lost, every stored mailbox credential is unrecoverable.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_ENCRYPTION_KEY=

# --- Support mailbox (REQUIRED for email features) ---
# A Gmail address and an App Password (NOT the account password).
EMAIL_USER=
EMAIL_PASS=
# Company id inbound email is attached to (interim, until per-company
# mailboxes in Phase 3). Leave blank to disable email ingestion.
INGEST_COMPANY_ID=
