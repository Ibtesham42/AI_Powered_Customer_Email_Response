# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Environment ---
# "production" tightens defaults: refresh-cookie Secure flag on + HSTS header
# (serve over HTTPS). Anything else is treated as development.
ENVIRONMENT=development

# --- Auth (REQUIRED) ---
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
# Short-lived access token (audit H2). The SPA refreshes transparently on 401.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Refresh-token cookie (audit H1) ---
# The refresh token rides in an httpOnly cookie (off the SPA's JS); the access
# token is held in memory. Defaults below suit a same-origin deploy.
#   COOKIE_SECURE  defaults to true in production, false otherwise. Set true
#                  whenever the API is served over HTTPS.
#   COOKIE_SAMESITE lax for same-origin (recommended). A separate-origin SPA
#                  must set "none" (requires COOKIE_SECURE=true) AND list its
#                  origin in CORS_ORIGINS below.
#   COOKIE_DOMAIN  optional parent domain (e.g. .example.com) for cross-subdomain.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# REFRESH_COOKIE_NAME=acs_refresh_token

# --- Logging ---
LOG_LEVEL=INFO

# --- Monitoring (recommended in production) ---
# Sentry error tracking for api + worker. Unset => disabled. Free tier is fine
# (errors only; tracing is off in code).
SENTRY_DSN=
# Dead-man switch the worker pings after each successful cycle (Healthchecks.io
# check URL). Alerts when the worker goes silent. Unset => disabled.
WORKER_HEARTBEAT_URL=

# --- Rate limiting (slowapi) — C2 ---
# Shared storage for request rate limits. Unset => in-memory (single-process
# only). REQUIRED in production: the app refuses to start in production without
# it, because per-process counters don't hold across instances. REDIS_URL is an
# accepted alias. Treat as a SECRET if it embeds a password; prefer TLS rediss://.
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=

# --- Database ---
# Defaults to local SQLite if unset. For Postgres (Neon, Supabase, Cloud SQL):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Connection pool tuning (Postgres only; ignored for SQLite) — C2. Defaults
# shown. The worker container sets smaller values (it is one low-concurrency
# loop): DB_POOL_SIZE=2, DB_MAX_OVERFLOW=2.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# --- LLM (REQUIRED for AI replies) ---
GROQ_API_KEY=
# Optional alternate providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
# Generation tuning (optional — sensible defaults shown).
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=500
# Groq request timeout in seconds; the call fails rather than hanging the worker.
LLM_TIMEOUT=30

# --- Mailbox credential encryption ---
# Fernet key encrypting each Company's stored mailbox App Password at rest.
# CRITICAL secret — if lost, every stored mailbox credential is unrecoverable.
# Back it up and rotate per docs/runbooks/mailbox-encryption-key.md.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_ENCRYPTION_KEY=
# Set true in any deployment that uses mailboxes: the API then refuses to start
# without a valid key. An INVALID key always fails fast regardless of this flag.
MAILBOX_ENCRYPTION_REQUIRED=false

# --- Support mailbox ---
# Per-Company support mailboxes are connected at runtime via
# POST /api/v1/mailbox/connect; credentials are encrypted at rest with the key
# above. EMAIL_USER / EMAIL_PASS below are used ONLY by the legacy standalone
# Streamlit apps (chat_app.py, email_streamlit_ui.py) — not the backend.
EMAIL_USER=
EMAIL_PASS=

# --- Transactional email (Resend) — password-reset emails ---
# Sign up at resend.com for an API key. RESEND_FROM_EMAIL must be on a
# verified domain; the default onboarding@resend.dev works for testing but
# can only send to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Base URL the password-reset link points at (the frontend reset page).
APP_BASE_URL=http://localhost:8000
# How long a reset link stays valid.
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend CORS (Vite + React SPA, ADR-0004) ---
# Browser origins allowed to call the API. Unused in dev (the Vite proxy makes
# the SPA same-origin); set for a separate-origin production deploy. CORS runs
# with credentials enabled (so the refresh cookie flows), so list explicit
# origins — the "*" wildcard is incompatible with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Escalation engine (optional — defaults shown) ---
# A fresh AI draft escalates its Ticket to a human below this confidence,
# or once the thread already has this many replies out.
ESCALATION_CONFIDENCE_THRESHOLD=40
ESCALATION_MAX_REPLIES=2
