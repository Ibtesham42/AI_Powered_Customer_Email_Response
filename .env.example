# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Auth (REQUIRED) ---
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM (REQUIRED for AI replies) ---
GROQ_API_KEY=
# Optional alternate providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile

# --- Support mailbox (REQUIRED for email features) ---
# A Gmail address and an App Password (NOT the account password).
EMAIL_USER=
EMAIL_PASS=
