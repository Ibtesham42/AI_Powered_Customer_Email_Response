# Caddy reverse proxy for the API (docker-compose.prod.yml).
#
# Automatic HTTPS: Caddy obtains and renews a Let's Encrypt certificate for
# $API_DOMAIN (set in .env) as long as the domain's DNS A record points at this
# host and ports 80/443 are reachable. Certificates persist in the caddy_data
# volume.
#
# Security headers (HSTS etc.) are set by the FastAPI app itself when
# ENVIRONMENT=production — not duplicated here.

{$API_DOMAIN} {
	reverse_proxy api:8000

	# Don't buffer big knowledge-base uploads in memory.
	request_body {
		max_size 64MB
	}
}
